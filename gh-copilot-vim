#!/usr/bin/env python3

import argparse
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


def ensure_prompt_toolkit() -> bool:
    try:
        import prompt_toolkit
        return True
    except ImportError:
        print("prompt_toolkit is required but not installed.")
        if not sys.stdin.isatty():
            print("Install it with: pip install prompt_toolkit")
            return False

        answer = input("Install prompt_toolkit now? [Y/n] ").strip().lower()
        if answer not in {"", "y", "yes"}:
            print("Install it with: pip install prompt_toolkit")
            return False

        try:
            subprocess.check_call(
                [sys.executable, "-m", "pip", "install", "--quiet", "prompt_toolkit"]
            )
        except subprocess.CalledProcessError:
            print(
                "Failed to install prompt_toolkit. "
                "Please install it manually with: pip install prompt_toolkit"
            )
            return False
        return True


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gh copilot-vim",
        description="Run gh copilot in a vim-enabled REPL.",
    )
    parser.add_argument("--effort")
    parser.add_argument("--model")
    parser.add_argument("--yolo", action="store_true")
    parser.add_argument("--allow-all", action="store_true")
    parser.add_argument("--add-dir", action="append", default=[])
    return parser


def forwarded_flags(args: argparse.Namespace) -> list[str]:
    flags: list[str] = []

    if args.effort:
        flags.extend(["--effort", args.effort])
    if args.model:
        flags.extend(["--model", args.model])
    if args.yolo:
        flags.append("--yolo")
    if args.allow_all:
        flags.append("--allow-all")
    for directory in args.add_dir:
        flags.extend(["--add-dir", directory])

    return flags


@dataclass
class SessionState:
    vim_enabled: bool = True
    turn_count: int = 0


def toolbar_text(
    args: argparse.Namespace,
    session_holder: dict[str, "PromptSession"],
    session_state: SessionState,
    navigation_mode: object,
) -> str:
    status_parts: list[str] = []

    if session_state.vim_enabled:
        mode = "INSERT"
        session = session_holder.get("session")
        app = getattr(session, "app", None) if session is not None else None
        if app is not None:
            vi_state = getattr(app.current_buffer, "vi_state", None)
            if vi_state is not None and vi_state.input_mode == navigation_mode:
                mode = "NORMAL"
        status_parts.append(f"[ VIM ] -- {mode} --")
    else:
        status_parts.append("[ -- ]")

    status_parts.append(f"model: {args.model or 'default'}")
    status_parts.append(f"effort: {args.effort or 'default'}")
    if args.yolo:
        status_parts.append("⚡ yolo")
    if args.allow_all:
        status_parts.append("✓ allow-all")
    status_parts.append(f"turn: {session_state.turn_count}")

    return "  |  ".join(status_parts)


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    base_flags = forwarded_flags(args)

    if not ensure_prompt_toolkit():
        return 1

    from prompt_toolkit import PromptSession
    from prompt_toolkit.enums import EditingMode
    from prompt_toolkit.history import FileHistory
    from prompt_toolkit.key_binding.vi_state import InputMode

    session_state = SessionState()
    session_holder: dict[str, PromptSession] = {}

    session = PromptSession(
        editing_mode=EditingMode.VI,
        history=FileHistory(str(Path.home() / ".copilot_vim_history")),
        bottom_toolbar=lambda: toolbar_text(
            args, session_holder, session_state, InputMode.NAVIGATION
        ),
    )
    session_holder["session"] = session

    while True:
        try:
            text = session.prompt(">>> ")
        except (EOFError, KeyboardInterrupt):
            print()
            return 0

        command = text.strip()

        if command in {":q", ":quit"}:
            return 0

        if command == "/vim":
            session_state.vim_enabled = not session_state.vim_enabled
            session.editing_mode = (
                EditingMode.VI if session_state.vim_enabled else EditingMode.EMACS
            )
            print(
                "vim mode enabled"
                if session_state.vim_enabled
                else "vim mode disabled"
            )
            continue

        if not command:
            continue

        session_state.turn_count += 1
        result = subprocess.run(
            ["gh", "copilot", "-p", text, "--continue", "-s", *base_flags],
            check=False,
        )
        if result.returncode != 0:
            print(f"gh copilot command failed with exit code {result.returncode}")


if __name__ == "__main__":
    sys.exit(main())
